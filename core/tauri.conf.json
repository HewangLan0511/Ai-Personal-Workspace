{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Workspace",
  "version": "0.1.0",
  "identifier": "com.baiyu.personalworkspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build && python ../system/build_sidecar.py",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Workspace",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/service"
    ]
  }
}
